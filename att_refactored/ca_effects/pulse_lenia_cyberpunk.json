{
  "name": "中心脉冲 × Lenia启发式生长 × 赛博朋克",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "exp(-((x-0.5)**2 + (y-0.5)**2) / 0.02)"
    }
  },
  "evolution": {
    "rule": "c + 0.12 * (2*exp(-(avg_n-0.32)**2/0.004) - 1 + 2*exp(-(avg_n-0.58)**2/0.01) - 1)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v*0.75 + 0.25*sin(v*9)*v",
    "green": "v*0.1 + 0.22*sin(v*6+3)*v",
    "blue": "v*0.85 + 0.15*sin(v*7+1)*v"
  }
}