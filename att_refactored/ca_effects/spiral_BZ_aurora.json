{
  "name": "螺旋波 × BZ反应模拟 × 极光",
  "version": "1.0",
  "grid": {
    "width": 256,
    "height": 192,
    "wrap": true,
    "initial": {
      "type": "formula",
      "expression": "0.5 + 0.5 * sin(atan2(y-0.5, x-0.5) * 6 + sqrt((x-0.5)**2+(y-0.5)**2) * 25)"
    }
  },
  "evolution": {
    "rule": "c + 0.06*(avg_n-c) + 0.22*c*(c-0.28)*(1-c) - 0.025*(avg_n-0.5)",
    "variables": [
      "c",
      "avg_n"
    ]
  },
  "color": {
    "mode": "per_channel",
    "red": "v*0.1 + 0.5*sin(v*8)*v",
    "green": "v*0.35 + 0.45*sin(v*6+2)*v",
    "blue": "v*0.65 + 0.3*sin(v*5+4)*v"
  }
}